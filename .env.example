# ==============================================================
# AaplaBoisar (आपलं Boisar) — Environment Configuration Template
# ==============================================================
# NOTE: All client-side environment variables in Vite must start with VITE_
# The application runs out-of-the-box with built-in mock fallbacks if these
# are left unset.

# 1. Application Metadata
VITE_APP_NAME="AaplaBoisar"
VITE_APP_TAGLINE="आपली माणसं, आपली ओळख"
VITE_APP_URL="https://aplaboisar.vercel.app"
VITE_DEFAULT_LOCALE="mr"

# 2. Backend & API Service Layer (Optional: when connecting a Node.js/NestJS server)
# Leave blank to use built-in offline-first localStorage mock services
VITE_API_BASE_URL=""

# 3. AI Service (Optional: for live OpenAI / Groq / Anthropic integrations)
# When unset, AaplaBoisar uses the integrated local multilingual NLP parser
VITE_AI_PROVIDER="mock"
VITE_AI_API_BASE_URL="https://api.openai.com/v1"
VITE_AI_API_KEY=""
VITE_AI_MODEL="gpt-4o-mini"

# 4. Maps & Geolocation (Optional: Google Maps / Mapbox API)
# When unset, the interactive custom vector map simulator is used
VITE_GOOGLE_MAPS_API_KEY=""
VITE_MAPBOX_TOKEN=""

# 5. Payments (Optional: Razorpay for subscriptions and ads)
# Test keys for Razorpay Sandbox (starts with rzp_test_...)
VITE_RAZORPAY_KEY_ID=""
VITE_RAZORPAY_KEY_SECRET=""

# 6. Storage & Media (Optional: Cloudinary / Supabase Storage for user uploads)
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""

# 7. Authentication (Optional: Firebase / Supabase)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
